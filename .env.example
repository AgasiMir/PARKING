ENVIRONMENT="LOCAL"

# Postgres
DB_DRIVER=postgresql+asyncpg
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=6432
POSTGRES_DB=parking


# Streaming-репликация (используется в docker/postgres-*-init/*.sh)
REPLICATION_USER=replicator
REPLICATION_PASSWORD=replicator_change_me

# Postgres_replica
DB_REPLICA_DRIVER=postgresql+asyncpg
POSTGRES_REPLICA_USER=postgres_r
POSTGRES_REPLICA_PASSWORD=postgres_r
# для локального запуска без compose; в .env.prod должно быть postgres_replica
DB_REPLICA_HOST=localhost
DB_REPLICA_PORT=7432
POSTGRES_REPLICA_DB=parking_r


# Grafana (используется в compose.prod.yaml, env_file: .env.prod)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
